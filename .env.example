# Portfolio Database Configuration Options
# To connect your contact form to a live database, rename this file to .env and configure one of the options below.

# --- Option A: Supabase Database Relay ---
# Create a table (e.g. 'leads') with columns 'name' (text), 'email' (text), and 'timestamp' (timestamptz).
# VITE_SUPABASE_URL=https://your-project-id.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# VITE_SUPABASE_TABLE=leads

# --- Option B: n8n Automation Relay ---
# Create a workflow in n8n starting with a Webhook trigger, and configure it to parse a POST payload with name & email.
# VITE_N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/your-webhook-id
