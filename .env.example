# Contact form relay
# Configure this server-side variable in your hosting provider. Keep it private;
# it is called only by /api/lead, never exposed to visitors.
#
# Create an n8n workflow beginning with a Webhook node. It receives:
# name, email, company, challenge, submittedAt
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/your-webhook-id
